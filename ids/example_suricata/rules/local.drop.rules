# DROP rules (high-confidence / higher thresholds)

# 1) SSH brute force (SYN threshold) — more strict than alert (was 5/60 -> drop 8/60)
drop tcp any any -> any 22 (msg:"DROP SSH brute force (SYN threshold)"; flags:S; threshold:type threshold, track by_src, count 8, seconds 60; classtype:attempted-recon; priority:1; sid:9101001; rev:1;)

# 2) SQLi - higher confidence drop versions
drop http any any -> any any (msg:"DROP SQLi HTTP URI - '' OR 1=1"; flow:to_server,established; http.uri; pcre:"/\b'?\s*OR\s+1\s*=\s*1\b/i"; classtype:web-application-attack; priority:1; sid:9101002; rev:1;)
drop http any any -> any any (msg:"DROP SQLi HTTP URI - UNION SELECT"; flow:to_server,established; http.uri; pcre:"/\bunion\s+select\b/i"; classtype:web-application-attack; priority:1; sid:9101003; rev:1;)

# 3) Command injection in POST body — drop when common command chains detected
drop http any any -> any any (msg:"DROP CMDi wget in HTTP body"; flow:to_server,established; http.request_body; content:"\;wget"; nocase; classtype:web-application-attack; priority:1; sid:9101004; rev:3;)
drop http any any -> any any (msg:"DROP CMDi curl in HTTP body"; flow:to_server,established; http.request_body; content:"\;curl"; nocase; classtype:web-application-attack; priority:1; sid:9101005; rev:3;)

# 4) Directory traversal: very high confidence
drop http any any -> any any (msg:"DROP Directory traversal attempt in URI"; flow:to_server,established; http.uri; pcre:"/\.\.\/\.\.\/|\.\.\/etc\/passwd/i"; classtype:web-application-attack; priority:1; sid:9101006; rev:1;)

# 5) XSS (if you want strict blocking of obvious script tags) — optional (keeps lower priority)
drop http any any -> any any (msg:"DROP XSS <script> tag in URI"; flow:to_server,established; http.uri; pcre:"/<\s*script\b[^>]*>/i"; classtype:web-application-attack; priority:2; sid:9101007; rev:1;)

# 8) SYN spike heuristic — raise threshold for drop vs alert (alert used count 6 -> drop use 10)
drop tcp any any -> any any (msg:"DROP DoS SYN spike to destination (lab)"; flags:S; threshold:type both, track by_dst, count 10, seconds 10; classtype:attempted-dos; priority:1; sid:9101011; rev:1;)

# 9) ICMP flood — raise threshold for drop (alert used count 6 -> drop use 8)
drop icmp any any -> any any (msg:"DROP ICMP echo-request flood (possible ping flood)"; itype:8; threshold:type both, track by_src, count 8, seconds 10; classtype:attempted-dos; priority:1; sid:9102001; rev:1;)

# (Existing test drop kept) HTTP test drop
#drop tcp any any -> any 80 (msg:"Drop HTTP test traffic"; sid:100001; rev:1;)

drop icmp any any -> $HOME_NET any (msg:"TEST DROP ALL ICMP TO HOME"; itype:8; sid:9102999; rev:1;)


alert icmp any any -> $HOME_NET any (msg:"TEST ALERT ICMP TO HOME"; itype:8; sid:9102998; rev:1;)
